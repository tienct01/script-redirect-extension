{
    "manifest_version": 3,
    "name": "TAMonkey",
    "version": "1.0",
    "description": "Redirects web requests to a specified host based on a pattern.",
    "permissions": ["storage", "declarativeNetRequestWithHostAccess", "declarativeNetRequest"],
    "host_permissions": ["<all_urls>"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
      }
    }
  }